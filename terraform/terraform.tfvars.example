# REQUIRED: Your IP address (get it: curl https://checkip.amazonaws.com)
my_ip = "YOUR_IP_HERE/32"  # Example: "203.0.113.45/32"

# REQUIRED: SSH key name (must already exist in AWS)
key_name = "your-key-name"  # Example: "airflow-key"

# Optional: Change instance size (default: t3.medium)
# instance_type = "t3.large"

# Optional: Create S3 bucket? (default: false)
# Only needed if using produce_data_assets DAG
# create_s3_bucket = true
# s3_bucket_name   = "data-platform-yourname"
