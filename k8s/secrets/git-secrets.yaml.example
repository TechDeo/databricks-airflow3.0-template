apiVersion: v1
kind: Secret
metadata:
  name: git-credentials
  namespace: airflow
data:
  # Base64 encoded GitHub username
  GITSYNC_USERNAME: <base64-encoded-github-username>
  GITSYNC_PASSWORD: <base64-encoded-github-token>
  GIT_SYNC_USERNAME: <base64-encoded-github-username>
  GIT_SYNC_PASSWORD: <base64-encoded-github-token>

# To encode your credentials:
# echo -n "your-github-username" | base64
# echo -n "your-github-token" | base64
